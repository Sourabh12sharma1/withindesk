# Local development (default): SQLite file at data/withindesk.sqlite
# DATABASE_PATH=./data/withindesk.sqlite

# Hostinger production: create a MySQL database in hPanel, then set these
# on the Node.js app environment. Do not commit real passwords.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=u123456789_withindesk
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=u123456789_withindesk

# Optional one-line form of the same settings:
# DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE
